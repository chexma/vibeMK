# CheckMK Server Configuration
CHECKMK_SERVER_URL=https://your-checkmk-server.example.com
CHECKMK_SITE=mysite
CHECKMK_USERNAME=automation
CHECKMK_PASSWORD=your-automation-password

# Optional: SSL Certificate Verification
CHECKMK_VERIFY_SSL=true

# Optional: Request Timeout (seconds)
CHECKMK_TIMEOUT=30

# Optional: Maximum Retries
CHECKMK_MAX_RETRIES=3

# Optional: Safety Feature - Disable Change Activation
# Set to true to prevent accidental activation of configuration changes
# Useful for development/testing environments
NEVER_ACTIVATE_CHANGES=false