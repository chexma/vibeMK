# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging artefacts. Anchored to the repository root on purpose: an
# unanchored build/ or lib/ would silently swallow a source directory of the
# same name anywhere in the tree.
/build/
/dist/
/sdist/
/eggs/
/.eggs/
/lib/
/lib64/
/var/
/wheels/
/develop-eggs/
/downloads/
/parts/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# Virtual environments. venv writes its own .gitignore inside the directory
# since Python 3.11, so .venv/ looks covered without being listed -- but that
# does not hold for virtualenv, for older interpreters, or for a directory
# someone names differently.
.venv/
venv/
env/
ENV/

# Tool caches. mypy and ruff also self-ignore, with the same caveat.
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Credentials: never commit these
.env
.env.local
.env.production

# Logs
*.log
logs/

# Scratch space
tmp/
temp/
*.tmp

# Documentation builds
docs/_build/

# LLM client configurations, which hold credentials
claude_desktop_config.json
llm_config.json

# Checkmk specifics
checkmk_config.json
test_credentials.json
openapi-swagger-ui.yaml

# Claude development notes: private, not for the repository. Both cases are
# listed because git matches patterns case-sensitively on Linux -- CLAUDE.md
# was only ever ignored here by accident of a case-insensitive filesystem.
claude.md
*/claude.md
**/claude.md
CLAUDE.md
**/CLAUDE.md
CLAUDE.local.md
**/CLAUDE.local.md
.claude/agents/
.claude/settings.local.json

# Personal working files
recommendations.md
pytest.errors
/plan
